# Application
APP_NAME="Group Insurance IDP API"
APP_ENV=development
LOG_LEVEL=INFO
PORT=8000

# 1. OCR engine — Azure Document Intelligence (prebuilt-layout). Leave empty for MOCK mode.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT="https://<your-resource>.cognitiveservices.azure.com/"
AZURE_DOCUMENT_INTELLIGENCE_KEY="<your-key>"
AZURE_DOCUMENT_INTELLIGENCE_MODEL_ID="prebuilt-layout"
OCR_CACHE_DIR=".cache/ocr"

# 2. LLM — 'openai' or 'azure_foundry'. Leave the key empty for MOCK mode.
LLM_PROVIDER="openai"
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-5.4-mini"
# reasoning models ignore temperature; effort applies to gpt-5*/o* only (minimal|low|medium|high)
OPENAI_REASONING_EFFORT="low"
LLM_MAX_OUTPUT_TOKENS=32000

AZURE_FOUNDRY_ENDPOINT=""
AZURE_FOUNDRY_API_KEY=""
AZURE_FOUNDRY_DEPLOYMENT_NAME="gpt-4o-mini"
AZURE_FOUNDRY_API_VERSION="2024-08-01-preview"

# 3. Dynamic target schema — BA-owned CSV (hot-swappable via POST /api/v1/catalog)
FIELD_CATALOG_PATH="example_data/expected_fields/expected_field_list.csv"

# 4. Extraction strategy
SHARD_STRATEGY="auto"          # auto | single | per_section
SHARD_TOKEN_BUDGET=24000
MAX_PARALLEL_SHARDS=4
CENSUS_TABULAR_MODE=true

# 5. Upload limits
MAX_UPLOAD_SIZE_MB=60
MAX_FILES_PER_DOCUMENT=60
